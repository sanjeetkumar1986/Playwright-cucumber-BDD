{
  "name": "playwright-cucumber-bdd",
  "version": "1.0.0",
  "description": "Playwright BDD framework with Cucumber and Page Object Model",
  "main": "index.js",
  "scripts": {
    "pretest": "rimraf allure-results allure-report",
    "test": "cucumber-js --config src/config/cucumber.js",
    "test:tags": "cucumber-js --tags",
    "test:failed": "cucumber-js --retry 1",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "test:report": "npm run test || npm run allure:generate && npm run allure:open"
  },
  "keywords": [
    "playwright",
    "cucumber",
    "bdd",
    "page-object-model"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "allure-commandline": "^2.46.1",
    "allure-cucumberjs": "^3.12.2",
    "dotenv": "^18.0.4",
    "rimraf": "^5.0.10",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
